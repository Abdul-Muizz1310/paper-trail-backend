# paper_trail
APP_ENV=development
LOG_LEVEL=info
PORT=8000

# Platform contract v2 (docs/specs/10-platform-contract-v2.md). With no key set every
# protected route answers 503; APP_ENV=test serves untokened requests anonymously instead.
DEMO_MODE=false
BASTION_SIGNING_KEY_PUBLIC=
# paper-trail-frontend's Ed25519 public key (base64 SPKI DER).
PAPER_TRAIL_FRONTEND_SIGNING_KEY_PUBLIC=

# Langfuse tracing (docs/specs/12-tracing.md): both keys set → one trace per debate; either
# blank → tracing is a no-op. APP_ENV above is the trace environment.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
